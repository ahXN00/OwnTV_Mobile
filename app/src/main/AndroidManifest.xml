<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET, ACCESS_NETWORK_STATE, FOREGROUND_SERVICE, FOREGROUND_SERVICE_DATA_SYNC and
         POST_NOTIFICATIONS merge in from :core, which does the networking and runs the sync and
         download workers. MODIFY_AUDIO_SETTINGS merges in from :player-core, which owns VolumeBoost.
         Nothing else is declared here yet, and four of the TV app's permissions never will be:
           - REQUEST_INSTALL_PACKAGES — no in-app updater in this app,
           - WRITE_EPG_DATA — Watch Next is an Android TV surface,
           - MANAGE/READ/WRITE_EXTERNAL_STORAGE — a phone has a document picker; use SAF,
           - the leanback / optional-touchscreen uses-feature pair — this app is touch-first. -->

    <!-- androidx.tvprovider declares both TV-provider permissions in its own manifest, and :core
         depends on it because LauncherIntegrationRepository (the facade core's sync worker calls)
         delegates to the Watch Next publisher. So they merge in here, into an app that can never use
         them: there is no TV launcher row on a phone. Removed explicitly rather than tolerated — a
         Watch Next permission on a phone app is the kind of thing a user reads in the app listing
         and does not forget. If core ever stops depending on tvprovider, delete these two lines. -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA"
        tools:node="remove" />
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA"
        tools:node="remove" />

    <!-- Playback has to keep running when the app is off screen, and from Android 14 a foreground
         service must declare the type it is. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Coarse, never fine, and asked for only when the user turns on "Use this device's location"
         for the weather. A phone moves and a television does not: without it the forecast is
         looked up from the network address, which is whichever city the operator routes through.
         Weather is measured over tens of kilometres, so street-level accuracy would be data
         collected for no reason. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".OwnTVMobileApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OwnTVMobile"
        android:usesCleartextTraffic="true"
        tools:targetApi="26">

        <!-- Disable WorkManager default auto-init; OwnTVMobileApp provides the Configuration, which
             is what installs core's Koin-aware WorkerFactory. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize">
            <!-- configChanges is what Picture-in-Picture needs: without it every entry into and exit
                 from the little window would rebuild the activity, and the stream would restart.
                 It takes rotation with it, which a player app wants anyway. -->
            <!-- LAUNCHER only. No LEANBACK_LAUNCHER: this app is not for a ten-foot UI. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- How the Cast SDK finds its configuration. It is instantiated reflectively by name, which
             is why the class is kept out of R8's reach in proguard-rules.pro. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="tv.own.owntv.mobile.cast.CastOptionsProvider" />

        <!-- Keeps the stream alive and puts it on the lockscreen. Not exported: it is driven by
             LiveTuner and by its own notification buttons, never by another app. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>

</manifest>
